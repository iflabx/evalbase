{
  "contractVersion": "parser-contract-v1",
  "decisions": {
    "fieldPath": "RFC 6901 JSON Pointer; ~ escapes as ~0 and / as ~1",
    "duplicateCsvHeaders": "reject with duplicate_field_name before emitting records",
    "duplicateJsonKeys": "reject with duplicate_field_name before emitting records",
    "jsonNumbers": "preserve finite IEEE-754 values and reject unsafe integer literals",
    "bom": "strip one leading BOM from decoded CSV/JSON/JSONL content only",
    "blankLines": "ignore blank CSV records and whitespace-only JSONL physical lines while retaining physical line locators",
    "malformedRecords": "JSONL errors are located records; malformed CSV or JSON makes boundaries untrusted",
    "nestedArrays": "accept one explicit RFC 6901 pointer to an array; reject JSONPath, wildcard, and multi-array selection",
    "locators": "CSV uses one-based dataRow plus ending physicalLine; JSON uses RFC 6901 pointer; JSONL uses one-based physicalLine",
    "emptyCsv": "ready with zero records and empty_source warning",
    "headerOnlyCsv": "ready with zero records, discovered header fields, and empty_source warning"
  },
  "cases": [
    {
      "id": "F-CSV-UTF8",
      "format": "csv",
      "source": { "utf8": "question,answer\nWhy?,Because.\n" },
      "config": {
        "encoding": "utf8",
        "delimiter": ",",
        "headerRow": 1,
        "quote": "\""
      },
      "expected": {
        "locator": { "kind": "csv_row", "dataRow": 1, "physicalLine": 2 },
        "fields": { "question": "Why?", "answer": "Because." },
        "recordHash": "987f265f243a212a42fdaa33729360f8cc96b2034d481b23b200396eca9e8a19"
      }
    },
    {
      "id": "F-CSV-BOM",
      "format": "csv",
      "source": { "base64": "77u/cXVlc3Rpb24sYW5zd2VyCldoeT8sQmVjYXVzZS4K" },
      "config": {
        "encoding": "auto",
        "delimiter": ",",
        "headerRow": 1,
        "quote": "\""
      },
      "expected": {
        "detectedEncoding": "utf8",
        "locator": { "kind": "csv_row", "dataRow": 1, "physicalLine": 2 },
        "fields": { "question": "Why?", "answer": "Because." },
        "recordHash": "987f265f243a212a42fdaa33729360f8cc96b2034d481b23b200396eca9e8a19"
      }
    },
    {
      "id": "F-CSV-GB18030",
