# Copy to .env, generate distinct random secrets, and keep the existing values on upgrades.
# Example: openssl rand -hex 32 (passwords); openssl rand -base64 32 (MODEL_ENCRYPTION_KEY).
POSTGRES_DB=evalbase_phase1a
POSTGRES_USER=evalbase_phase1a
POSTGRES_PASSWORD=
# Use the same database/user/password above; URL-encode special characters in the password.
DATABASE_URL=
MINIO_ACCESS_KEY=evalbase-local
MINIO_SECRET_KEY=
MINIO_BUCKET=evalbase-phase1a
MODEL_ENCRYPTION_KEY=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# The first administrator is created in the browser. No default login password.
